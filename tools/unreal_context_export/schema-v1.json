{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dp.unreal.context/v1",
  "title": "DP Unreal Context Export",
  "type": "object",
  "required": ["schemaVersion", "readOnly", "asset", "dependencies", "referencers", "graph", "validation", "errors"],
  "properties": {
    "schemaVersion": {"const": "dp.unreal.context/v1"},
    "readOnly": {"const": true},
    "asset": {
      "type": "object",
      "required": ["objectPath"],
      "properties": {"objectPath": {"type": "string", "pattern": "^/Game/"}}
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "referencers": {"type": "array", "items": {"type": "string"}},
    "graph": {
      "type": "object",
      "required": ["kind", "coverage", "nodes"],
      "properties": {
        "coverage": {"type": "object"},
        "nodes": {"type": "array"}
      }
    },
    "validation": {"type": "object"},
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
